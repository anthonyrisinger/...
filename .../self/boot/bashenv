#!/bin/bash

if [[ -z ${DIRENV_IN_ENVRC-} ]] && [[ -z ${ELLIPSIS_DIRENV_GUARD-} ]]; then
  direnv_bin=$(command -v direnv 2>/dev/null)
  if [[ -z ${direnv_bin} ]]; then
    for candidate in /opt/homebrew/bin/direnv /usr/local/bin/direnv; do
      if [[ -x ${candidate} ]]; then
        direnv_bin=${candidate}
        break
      fi
    done
  fi
  if [[ -n ${direnv_bin} ]]; then
    export ELLIPSIS_DIRENV_GUARD=1
    direnv_export="$("${direnv_bin}" export bash 2>/dev/null)" || direnv_export=""
    [[ -z ${direnv_export} ]] || eval "${direnv_export}"
    unset direnv_export
    unset ELLIPSIS_DIRENV_GUARD
  fi
fi
