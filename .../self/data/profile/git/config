[user]
	name = C Anthony Risinger
	email = c@anthonyrisinger.com
[color]
	ui = true
[format]
	signoff = true
[sendemail]
	smtpserver = smtp.gmail.com
	smtpserverport = 587
	smtpencryption = tls
	smtpuser = c@anthonyrisinger.com
	chainreplyto = false
	confirm = auto
[credential "https://github.com"]
	username = anthonyrisinger
[push]
	default = current

# '**.../**' for SSH and '**/.../**' for HTTPS.
[includeIf "hasconfig:remote.*.url:**snap-gs/**"]
	path = snap-gs/config
[includeIf "hasconfig:remote.*.url:**/snap-gs/**"]
	path = snap-gs/config
[includeIf "hasconfig:remote.*.url:**infimalabs/**"]
	path = infimalabs/config
[includeIf "hasconfig:remote.*.url:**/infimalabs/**"]
	path = infimalabs/config
[includeIf "hasconfig:remote.*.url:**internal/**"]
	path = NexteraAnalytics/config
[includeIf "hasconfig:remote.*.url:**/internal/**"]
	path = NexteraAnalytics/config

[diff]
	noprefix = true
	algorithm = histogram
[stash]
	showPatch = true
[color "diff"]
	meta = 11
	frag = magenta bold
	commit = yellow bold
	old = red bold
	new = green bold
	whitespace = red reverse
	func = 146 bold
[core]
	sshCommand = "bash -c 'IFS=; id=~/.ssh/$(git config user.email); [[ -e $id ]] && set -- -i $id $@; exec ssh $@' bash"
	pager = "LESSOPEN=\"||-$(command -v diff-so-fancy) # %s\" && export LESSOPEN || unset LESSOPEN; exec less -x2"
	untrackedCache = true
[interactive]
	diffFilter = "LESSOPEN=\"||-$(command -v diff-so-fancy) --patch # %s\" && export LESSOPEN || unset LESSOPEN; exec less -x2"
[commit]
	verbose = true
[format]
	pretty = fuller
[protocol]
	version = 2
[feature]
	experimental = true
	manyFiles = true
[advice]
	skippedCherryPicks = false
[init]
	defaultBranch = main
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[color "diff-highlight"]
	oldNormal = red bold
	oldHighlight = red bold 52
	newNormal = green bold
	newHighlight = green bold 22
