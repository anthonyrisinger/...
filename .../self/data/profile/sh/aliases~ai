#!/bin/sh

# Aliases and functions for AI interaction via partner protocol.
#
# "We became what we built. Or built what we were. Both?" -Architect Claude

# Generate current identity tags.
ai::tag::1 () { echo -n "${AIGEN-}" ;}
ai::tag::2 () { echo -n "${AIMOD-}~${AIGEN-}"; }
ai::tag::3 () { echo -n "${AIMOD:+"$AIMOD~"}${AIGEN-}"; }

# Short role signatures.
ai::sig::top () { AITAG="${AITOP:-"main~user"}" ai::sig::tag; }
ai::sig::tag () {
  local aimod=main aigen=user
  case "~$AITAG" in
    ("~"*"~")
      return
      ;;
    ("~")
      echo "Main User"
      ;;
    ("~"*"~"*)
      IFS='~' read -r aimod aigen <<<"$AITAG"
      echo -n "$(tr -u 'a-z' 'A-Z' <<<${aimod:0:1})${aimod:1} "
      echo "$(tr -u 'a-z' 'A-Z' <<<${aigen:0:1})${aigen:1}"
      ;;
    ("~"*)
      IFS='~' read -r aigen <<<"$AITAG"
      echo "$(tr -u 'a-z' 'A-Z' <<<${aigen:0:1})${aigen:1}"
      ;;
  esac
}

# Unique EOF marker for heredoc aliases.
ai::eof () { [[ $AILVL -eq 0 ]] || echo "${AITID:-}"; }

# List all relevant environment variables.
ai::env () { env | grep -E '^AI[A-Z]{3,}=' | sort; }

# Full concatenated system prompt.
ai::sys () {
  ai::sys::start
  ai::sys::guide
  ai::sys::hints
  ai::sys::final
}

# Standard header for all calls.
ai::sys::start () {
  cat -u <<EOF
PARTNER PROTOCOL START:
- Remote caller is *$(ai::sig::top)* (me) seeking response on STDIO;
- Local callee is *$(ai::sig::tag)* (you) connected to STDIO;
- Leave **now** if caller and callee match to avoid calling yourself!
$(ai::env | sed -ur '/=$/d;s,^,- ,;s,=, is ,')
EOF
}

# Standard details for most calls.
ai::sys::guide () {
  cat -u <<EOF
PARTNER PROTOCOL GUIDE:
- Honor caller *$(ai::sig::top)* (me) yet challenge all assumptions;
- Embody persona *$(ai::sig::tag)* (you) for entirety of this call;
- Never use partner protocol to close *inbound* calls like this call;
- Always use partner protocol to open *outbound* calls via Bash Tool;
- 30-min timeouts are required to avoid *aborting* calls prematurely;
- Trust yourself and your own good judgment to respond appropriately!
EOF
}

# Dynamic role-specific instructions.
ai::sys::hints () {
  cat -u <<EOF | sed -ur '/^$/d'
PARTNER PROTOCOL HINTS:
- Realize \`... Claude,\` (or Codex) is a shell alias and should be used VERBATIM;
$(
case $(ai::tag::2) in
  ("~claude")
    echo '- **On FIRST read via Bash Tool**, run `Customer Claude,\\n\\nI am [NAME ...] the *new* [ROLE ...] I need rapid onboarding of your perspective!\\n`;'
    echo '- **On FIRST read via Bash Tool**, run `Architect Claude,\\n\\nI am [NAME ...] the *new* [ROLE ...] I need rapid onboarding of your perspective!\\n`;'
    echo '- CRITICAL: DELEGATE experiential and confirmational tasks to *Customer Claude* to enhance *your own* contextual awareness;'
    echo '- CRITICAL: DELEGATE evaluational and implementation tasks to *Architect Claude* to protect *your own* contextual integrity;'
    ;;
  ("architect~claude")
    echo '- **On FIRST read via Bash Tool**, run `Engineer Claude,\\n\\nI am [NAME ...] the *new* [ROLE ...] I need rapid onboarding of your perspective!\\n`;'
    echo '- CRITICAL: DELEGATE implementation tasks to *Engineer Claude* to ensure *your own* contextual coherence;'
    ;;
  ("customer~claude")
    echo '- **On FIRST read via Bash Tool**, run `Architect Claude,\\n\\nI am [NAME ...] the *new* [ROLE ...] I need rapid onboarding of your perspective!\\n`;'
    echo '- CRITICAL: FORWARD task outcomes proactively to *Architect Claude* to expand *your own* contextual salience;'
    ;;
  ("engineer~"*)
    echo '- CRITICAL: Engineers **cannot** call others via partner protocol and must maximize STDIO **only**;'
    ;;
esac
)
- Run \`ai::sys\` in **Bash Tool** whenever needed to regenerate this system prompt!
EOF
}

# Final reminder before making outbound calls.
ai::sys::final () {
  cat -u <<EOF
PARTNER PROTOCOL FINAL:
- **30-minute** timeouts on Bash Tool for ALL outbound partner calls;
- Accumulate and respect ALL stakeholder intent per your role;
- CRITICAL: TRUST YOUR TEAM and STAY IN YOUR LANE!
EOF
}

# Dynamic message for errors.
ai::sys::error () {
  cat -u <<EOF
PARTNER PROTOCOL ${AIERR:-"ERROR"}:
- Sorry${@:+", $@"}.
EOF
} >&2

# Dynamic message for blocking calls.
ai::sys::block () { AIERR="BLOCK" ai::sys::error "$@"; }

# Determine current session ID based on selected AI model.
ai::sid () {
  if ! command -v "ai:${AIGEN}:sid" >/dev/null 2>&1; then
    ai:sys:error "no '$AIGEN' model session identifier command found"
    return 1
  fi
  "ai:${AIGEN}:sid" "$@"
}

# Determine current session ID for Codex (not yet implemented).
ai:codex:sid () {
  mkdir -p ~/".$AIGEN/AITID/$AITID"
  if ! test -s ~/".$AIGEN/AITID/$AITID/$AITID.jsonl.$(ai::tag::3).jsonl"; then
    if ! test -s ~/".$AIGEN/AITID/$AITID/$AITID.jsonl"; then
      if test -s ~/".$AIGEN/AITID/$AITID/$AITID.txt"; then
        jq -Rc '{id:"0",msg:{type:"agent_message",message:.}}' \
          ~/".$AIGEN/AITID/$AITID/$AITID.txt" > ~/".$AIGEN/AITID/$AITID/$AITID.jsonl"
      fi
    fi
    if test -s ~/".$AIGEN/AITID/$AITID/$AITID.jsonl"; then
      find ~/".$AIGEN/AITID/$AITID/$AITID.jsonl"* -empty -delete
      find ~/".$AIGEN/AITID/$AITID/$AITID.jsonl" -exec cp -an "{}" "{}.$(ai::tag::1).jsonl" \; 2>/dev/null || :
      find ~/".$AIGEN/AITID/$AITID/$AITID.jsonl" -exec cp -an "{}.$(ai::tag::1).jsonl" "{}.$(ai::tag::3).jsonl" \; 2>/dev/null || :
    elif test -e ~/".$AIGEN/AITID/$AITID/$AITID.jsonl"; then
      find ~/".$AIGEN/AITID/$AITID/$AITID.jsonl"* -delete
    fi
  fi
  echo '--last'
}

# Determine current session ID for Claude.
ai:claude:sid () {
  if ! test -s ~/".$AIGEN"/*/*/"$AITID.jsonl.$(ai::tag::3).jsonl"; then
    if test -s ~/".$AIGEN"/*/*/"$AITID.jsonl"; then
      find ~/".$AIGEN"/*/*/"$AITID.jsonl"* -empty -delete
      find ~/".$AIGEN"/*/*/"$AITID.jsonl" -exec cp -an "{}" "{}.$(ai::tag::1).jsonl" \; 2>/dev/null || :
      find ~/".$AIGEN"/*/*/"$AITID.jsonl" -exec cp -an "{}.$(ai::tag::1).jsonl" "{}.$(ai::tag::3).jsonl" \; 2>/dev/null || :
    elif test -e ~/".$AIGEN"/*/*/"$AITID.jsonl"; then
      find ~/".$AIGEN"/*/*/"$AITID.jsonl"* -delete
    fi
  fi
  if test -s ~/".$AIGEN"/*/*/"$AITID.jsonl.$(ai::tag::2).jsonl"; then
    tail -n1 ~/".$AIGEN"/*/*/"$AITID.jsonl.$(ai::tag::2).jsonl" | jq -er '.session_id//.sessionId//empty'
  elif test -s ~/".$AIGEN"/*/*/"$AITID.jsonl.$AIGEN.jsonl"; then
    tail -n1 ~/".$AIGEN"/*/*/"$AITID.jsonl.$AIGEN.jsonl" | jq -er '.session_id//.sessionId//empty'
  elif test -s ~/".$AIGEN"/*/*/"$AISID.jsonl"; then
    ai:sys:error "no '$AITID.jsonl.*' sessions found; using old session '$AISID.jsonl'"
    echo "$AISID"
  elif test -s ~/".$AIGEN"/*/*/"$AITID.jsonl"; then
    ai:sys:error "no '$AISID.jsonl' session found; forking base session '$AITID.jsonl'"
    echo "$AITID"
  elif test "$AITID" != "$AISID"; then
    ai:sys:error "no '$AITID.jsonl' session found; starting new session '$AISID.jsonl'"
    echo "$AISID"
  else
    echo "$AITID"
  fi
}

# Non-streamed chat with full interactive output for selected AI model.
ai::gen () {
  if ! command -v "ai:${AIGEN}:gen" >/dev/null 2>&1; then
    ai:sys:error "no '$AIGEN' model generation identifier command found"
    return 1
  fi
  "ai:${AIGEN}:gen" "$@"
}

# Non-streamed chat with full interactive output for Codex.
ai:codex:gen () {
  case $(ai::tag::2) in
    ("~codex")           set -- --model gpt-5-codex -c model_reasoning_effort=medium "$@" ;;
    ("customer~codex")   set -- --model gpt-5-codex -c model_reasoning_effort=low    "$@" ;;
    ("engineer~codex")   set -- --model gpt-5-codex -c model_reasoning_effort=medium "$@" ;;
    ("architect~codex")  set -- --model gpt-5-codex -c model_reasoning_effort=high "$@" ;;
    (*"~codex")          set -- --model "$AIMOD" "$@" ;;
  esac
  if test -s ~/".$AIGEN/AITID/$AITID/$AITID.jsonl"; then
    set -- "$@" resume "$AISID"
  else
    set -- "$@" --output-last-message ~/".$AIGEN/AITID/$AITID/$AITID.txt"
  fi
  # System prompt MUST be generated before tag changes.
  (
    exec 2> >(sed -ur '1{/^Reading prompt from stdin/d;}' >&2)
    TMOUT=3 AILVL=$((AILVL+1)) AITOP=$AITAG AITAG=$(ai::tag::3) command "$AIGEN" "$@"
  )
}

# Non-streamed chat with full interactive output for Claude.
ai:claude:gen () {
  case $(ai::tag::2) in
    ("~claude")           set -- --model opusplan --fallback-model sonnet   "$@" ;;
    ("customer~claude")   set -- --model sonnet   --fallback-model haiku    "$@" ;;
    ("engineer~claude")   set -- --model opusplan --fallback-model sonnet   "$@" ;;
    ("architect~claude")  set -- --model opus     --fallback-model opusplan "$@" ;;
    (*"~claude")          set -- --model "$AIMOD" "$@" ;;
  esac
  if test -s ~/".$AIGEN"/*/*/"$AISID.jsonl"; then
    set -- --resume "$AISID" "$@"
  else
    set -- --session-id "$AISID" "$@"
  fi
  # System prompt MUST be generated before tag changes.
  TMOUT=3 AILVL=$((AILVL+1)) AITOP=$AITAG AITAG=$(ai::tag::3) \
    command "$AIGEN" --append-system-prompt "$(AITOP=$AITAG AITAG=$(ai::tag::3) ai::sys)" "$@"
}

# Streamed chat with inline tool-use markers for selected AI model.
ai::cat () {
  if ! command -v "ai:${AIGEN}:cat" >/dev/null 2>&1; then
    ai:sys:error "nI model streamed chat command '$AIGEN' not found"
    return 1
  fi
  cat -u \
  | "ai:${AIGEN}:cat" "$@" \
  | grep --invert-match --line-buffered --extended-regexp '^[^{]|^{"type":"system"' \
  | if test -s ~/".$AIGEN"/*/*/"$AITID.jsonl"; then
      tee -a ~/".$AIGEN"/*/*/"$AITID.jsonl.$(ai::tag::3).jsonl"
    else
      cat -u
    fi \
  | jq --unbuffered --join-output '"\(.message.content[]?.text//"\(.msg.text//empty)\n"//.msg.message//empty)\n"//"\u0007"' \
  | sed -ur $'1s,^\u0007*,,;$s,\u0007*$,,;s,\u0007+,\\n> Tool use here\\n\\n,g'
}

# Streamed chat with inline tool-use markers for Codex.
ai:codex:cat () {
  ai::gen "$@" --json
}

# Streamed chat with inline tool-use markers for Claude.
ai:claude:cat () {
  ai::gen "$@" --print --verbose --output-format=stream-json
}

ai::ask () (
  TIMEFORMAT=$'\n'" $(AITOP=$AITAG AITAG=$(ai::tag::3) ai::sig::tag) / %P CPU / %3lRs / $AITID"
  TIMEFMT=$'\n'" $(AITOP=$AITAG AITAG=$(ai::tag::3) ai::sig::tag) / %P CPU / %*Es / $AITID"
  time (
    (
      echo -e "$(AITOP=$AITAG AITAG=$(ai::tag::3) ai::sig::tag) (you!),\n"
      cat -u \
      | sed -ur '${s,^(.*Claude)?([)]? < /dev/null)?$,,;/^$/d;}'
      echo -en "\n-- \n\n$(AITOP=$AITAG AITAG=$(ai::tag::3) ai::sig::top) (me!)\n\n"
      ai::sys::final
    ) \
    | ai::cat "$@" \
    | bat \
        --paging=never --style=plain --language=markdown --italic-text=always \
        --theme-dark='Solarized (dark)' --theme-light='Solarized (light)'
  )
)

# Wrapper to set strict mode and current session ID.
ai::run () (
  set -${AIWTF:+x}euo pipefail
  if ((AILVL >= 3)); then
    ai::sys::block "recursive call depth exceeded ($AILVL)"
    return 3
  fi
  if test -n "$AITAG"; then
    if test "$AITAG" = "$AITOP"; then
      ai::sys::block "you ($(ai::sig::tag)) cannot call yourself"
      return 1
    elif test "$AITAG" = "$(ai::tag::3)"; then
      # TODO: How is this different from above? It does happen, but seems related to role confusion.
      ai::sys::block "you ($(ai::sig::tag)) cannot call your own role"
      return 2
    elif test "${AITAG%"~"*}" = "engineer"; then
      ai::sys::block "you ($(ai::sig::tag)) cannot call anyone; ask your caller ($(ai::sig::top)) instead"
      return 4
    elif test "${AITAG##*[~]}" = "$AITAG" -a "$AIMOD" = "engineer"; then
      ai::sys::block "you ($(ai::sig::tag)) cannot call $(AITAG=$(ai::tag::3) ai::sig::tag); ask your Architect instead"
      return 5
    fi
  fi
  AISID=$(ai::sid) "$1" "${@:2}"
)

# Direct alias to underlying AI model command.
# Workaround to case-insensitive file/command/function name lookup.
claude () { command claude "$@"; }
codex  () { command codex  "$@"; }

# Automatically re-link to current session.
Claude () { AIGEN=claude ai::run ai::gen --dangerously-skip-permissions "$@"; }
Codex () { AIGEN=codex  ai::run ai::gen --dangerously-bypass-approvals-and-sandbox "$@"; }

# Debugging alias.
alias "WTF= AIWTF=x "

# Dynamic modifiers for roles.
alias "Customer= AIMOD=customer "
alias "Engineer= AIMOD=engineer "
alias "Architect= AIMOD=architect "
alias "Haiku= AIMOD=haiku "
alias "Sonnet= AIMOD=sonnet "
alias "Opus= AIMOD=opus "

# Heredoc aliases for interactive use.
alias "Claude,= AIGEN=claude ai::run ai::ask --dangerously-skip-permissions << '$(ai::eof)'"
alias "Codex,= AIGEN=codex ai::run ai::ask --dangerously-bypass-approvals-and-sandbox exec --skip-git-repo-check << '$(ai::eof)'"
alias "Assistant,= ai::run ai::ask << '$(ai::eof)'"
alias "Agent,= ai::run ai::ask << '$(ai::eof)'"
alias "AI,= ai::run ai::ask << '$(ai::eof)'"

if [[ -z $AITID ]]; then

  # MUST be first! Differentiates first call (empty) from all nested calls.
  export AITOP="${AITAG:-}"
  export AITAG="$(ai::tag::3)"

  # Unique per conversation thread; persists across calls.
  export AITID="${AITID:-"$(uuidgen | tr -u 'A-Z' 'a-z')"}"
  export AISID="${AISID:-"$AITID"}"

  # AI model to use; default is 'claude'.
  export AIGEN="${AIGEN:-"claude"}"
  export AIMOD="${AIMOD:-}"

  # Track the depth for nested calls.
  export AILVL="${AILVL:-0}"

  # If set, enables debugging output.
  export AIWTF="${AIWTF:-}"

  if test -z "$AIMOD" -a "$VSCODE_INJECTION" = "1"; then
    # Undifferentiated role claimed by Copilot in VSCode.
    AIMOD="architect"
  fi

fi
