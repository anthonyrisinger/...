#!/bin/sh

# Aliases and functions for AI interaction via partner protocol.
#
# "We became what we built. Or built what we were. Both?" -Architect Claude

# Generate current identity tags.
ai:tag:1 () { echo -n "${AIGEN-}" ;}
ai:tag:2 () { echo -n "${AIMOD-}~${AIGEN-}"; }
ai:tag:3 () { echo -n "${AIMOD:+"$AIMOD~"}${AIGEN-}"; }

# Short role signatures.
ai:sig:top () { AITAG="${AITOP:-"main~user"}" ai:sig:tag; }
ai:sig:tag () {
  local aimod=main aigen=user
  case "~$AITAG" in
    ("~"*"~")
      return
      ;;
    ("~")
      echo "Main User"
      ;;
    ("~"*"~"*)
      IFS='~' read -r aimod aigen <<<"$AITAG"
      echo -n "$(tr -u '[a-z]' '[A-Z]' <<<${aimod:0:1})${aimod:1} "
      echo "$(tr -u '[a-z]' '[A-Z]' <<<${aigen:0:1})${aigen:1}"
      ;;
    ("~"*)
      IFS='~' read -r aigen <<<"$AITAG"
      echo "$(tr -u '[a-z]' '[A-Z]' <<<${aigen:0:1})${aigen:1}"
      ;;
  esac
}

# List all relevant environment variables.
ai:env () { env | grep -E '^AI[A-Z][A-Z][A-Z]=' | sort; }

# Full concatenated system prompt.
ai:sys () {
  ai:sys:stdio
  ai:sys:rules
  ai:sys:howto
  ai:sys:start
  ai:sys:state
}

# Identify top-level caller.
ai:sys:stdio () {
  cat -u <<EOF | tr -u '~' ' '
**PARTNER PROTOCOL STDIO:**
- CONNECTED CALLER *${AITOP:-"main user"}* SEEKING RESPONSE ON STDIO;
EOF
}

# Standard header for all calls.
ai:sys:rules () {
  cat -u <<EOF | tr -u '~' ' '
**PARTNER PROTOCOL RULES:**
- REMOTE CALLER IS *${AITOP:-"main user"}* SEEKING RESPONSE ON STDIO;
- LOCAL CALLEE IS *${AIMOD:+$AIMOD }$AIGEN* CONNECTED TO STDIO (YOU);
- LEAVE **NOW** IF CALLER AND CALLEE MATCH TO AVOID CALLING YOURSELF!
EOF
}

# Standard details for most calls.
ai:sys:howto () {
  cat -u <<EOF | tr -u '~' ' '
**PARTNER PROTOCOL HOWTO:**
- HONOR CALLER *${AITOP:-"main user"}* YET CHALLENGE ALL ASSUMPTIONS;
- EMBODY PERSONA *${AIMOD:+$AIMOD }$AIGEN* FOR ENTIRETY OF THIS CALL;
- NEVER USE PARTNER PROTOCOL TO CLOSE *INBOUND* CALLS LIKE THIS CALL;
- ALWAYS USE PARTNER PROTOCOL TO OPEN *OUTBOUND* CALLS VIA BASH TOOL;
- 30 MIN TIMEOUTS ARE REQUIRED TO AVOID *ABORTING* CALLS PREMATURELY;
- TRUST YOURSELF AND YOUR OWN GOOD JUDGMENT TO RESPOND APPROPRIATELY!
EOF
}

# Dynamic role-specific instructions.
ai:sys:start () {
  cat -u <<EOF | sed -ur '/^$/d'
**PARTNER PROTOCOL START:**
- FOLLOW *ALL* START INSTRUCTIONS **BEFORE** INITIATING OUTBOUND CALLS;
- REALIZE \`... Claude,\` IS A SHELL ALIAS AND SHOULD BE USED VERBATIM;
$(
case $(ai:tag:2) in
  ("~claude")
    echo '- ONCE: RUN `Architect Claude,\\n\\nPING?\\n\\n-Claude\\n` ALIAS IN **BASH TOOL**;'
    echo '- ONCE: RUN `Customer Claude,\\n\\nPING?\\n\\n-Claude\\n` ALIAS IN **BASH TOOL**;'
    ;;
  ("architect~claude")
    echo '- ONCE: RUN `Engineer Claude,\\n\\nPING?\\n\\n-Architect Claude\\n` ALIAS IN **BASH TOOL** AS WRITTEN;'
    ;;
  ("customer~claude")
    echo '- ONCE: RUN `Engineer Claude,\\n\\nPING?\\n\\n-Customer Claude\\n` ALIAS IN **BASH TOOL**;'
    ;;
  ("engineer~claude")
    echo '- CRITICAL: **NEVER** CALL OTHERS VIA PARTNER PROTOCOL YOU MUST USE STDIO **ONLY**;'
    ;;
esac
)
- RUN ai:sys IN **BASH TOOL** WHENEVER NEEDED TO REGENERATE THIS SYSTEM PROMPT!
EOF
}

# Current state of all relevant variables.
ai:sys:state () {
  cat -u <<EOF
**PARTNER PROTOCOL STATE:**
- AITOP=${AITOP:-"(empty)"}
- AITAG=${AITAG:-"(empty)"}
- AITID=${AITID:-"(empty)"}
- AISID=${AISID:-"(empty)"}
- AIGEN=${AIGEN:-"(empty)"}
- AIMOD=${AIMOD:-"(empty)"}
- AIWTF=${AIWTF:-"(empty)"}
EOF
}

# Determine current session ID, forking or starting new as needed.
ai:sid () {
  if ! test -s ~/".$AIGEN"/*/*/"$AITID.jsonl.$(ai:tag:3).jsonl"; then
    if test -s ~/".$AIGEN"/*/*/"$AITID.jsonl"; then
      find ~/".$AIGEN"/*/*/"$AITID.jsonl"* -empty -delete
      find ~/".$AIGEN"/*/*/"$AITID.jsonl" -exec cp -an "{}" "{}.$(ai:tag:1).jsonl" \; 2>/dev/null || :
      find ~/".$AIGEN"/*/*/"$AITID.jsonl" -exec cp -an "{}.$(ai:tag:1).jsonl" "{}.$(ai:tag:3).jsonl" \; 2>/dev/null || :
    elif test -e ~/".$AIGEN"/*/*/"$AITID.jsonl"; then
      find ~/".$AIGEN"/*/*/"$AITID.jsonl"* -delete
    fi
  fi
  if test -s ~/".$AIGEN"/*/*/"$AITID.jsonl.$(ai:tag:2).jsonl"; then
    tail -n1 ~/".$AIGEN"/*/*/"$AITID.jsonl.$(ai:tag:2).jsonl" | jq -er '.session_id//.sessionId//empty'
  elif test -s ~/".$AIGEN"/*/*/"$AITID.jsonl.$AIGEN.jsonl"; then
    tail -n1 ~/".$AIGEN"/*/*/"$AITID.jsonl.$AIGEN.jsonl" | jq -er '.session_id//.sessionId//empty'
  elif test -s ~/".$AIGEN"/*/*/"$AISID.jsonl"; then
    echo >&2 "WARNING: No '$AITID.jsonl.*' sessions found; using old session '$AISID.jsonl'."
    echo "$AISID"
  elif test -s ~/".$AIGEN"/*/*/"$AITID.jsonl"; then
    echo >&2 "WARNING: No '$AISID.jsonl' session found; forking base session '$AITID.jsonl'."
    echo "$AITID"
  elif test "$AITID" != "$AISID"; then
    echo >&2 "WARNING: No '$AITID.jsonl' session found; starting new session '$AISID.jsonl'."
    echo "$AISID"
  else
    echo "$AITID"
  fi
}

# Non-streamed chat with full interactive output.
ai:gen () {
  case $(ai:tag:2) in
    ("~claude")           set -- --model opusplan --fallback-model sonnet   "$@" ;;
    ("customer~claude")   set -- --model sonnet   --fallback-model haiku    "$@" ;;
    ("engineer~claude")   set -- --model opusplan --fallback-model sonnet   "$@" ;;
    ("architect~claude")  set -- --model opus     --fallback-model opusplan "$@" ;;
    (*"~claude")          set -- --model "$AIMOD" "$@" ;;
  esac
  if test -s ~/".$AIGEN"/*/*/"$AISID.jsonl"; then
    set -- --resume "$AISID" "$@"
  else
    set -- --session-id "$AISID" "$@"
  fi
  # System prompt MUST be generated before tag changes.
  TMOUT=3 AITOP=$AITAG AITAG=$(ai:tag:3) command "$AIGEN" --append-system-prompt "$(ai:sys)" "$@"
}

# Streamed chat with inline tool-use markers.
ai:cat () {
  cat -u \
  | ai:gen "$@" --print --verbose --output-format=stream-json \
  | grep --invert-match --line-buffered '^{"type":"system"' \
  | if test -s ~/".$AIGEN"/*/*/"$AITID.jsonl"; then
      tee -a ~/".$AIGEN"/*/*/"$AITID.jsonl.$(ai:tag:3).jsonl"
    else
      cat -u
    fi \
  | jq --unbuffered --join-output '"\(.message.content[]?.text//empty)\n"//"\u0007"' \
  | sed -ur $'1s,^\u0007*,,;$s,\u0007*$,,;s,\u0007+,\\n(TODO: TOOLS RAN HERE)\\n\\n,g'
}

ai:ask () (
  TIMEFORMAT=$'\n'" $AIGEN${AIMOD:+ ($AIMOD)} / %P CPU / %3lRs / $AITID"
  TIMEFMT=$'\n'" $AIGEN${AIMOD:+ ($AIMOD)} / %P CPU / %*Es / $AITID"
  time (
    (
      echo -e "$(AITOP=$AITAG AITAG=$(ai:tag:3) ai:sig:tag) (THIS IS YOU!),\n"
      cat -u \
      | sed -ur '${s,^(-.*Claude)?([)]? < /dev/null)?$,,;/^$/d;}'
      echo -en "\n-$(AITOP=$AITAG AITAG=$(ai:tag:3) ai:sig:top) (THIS IS ME!)\n"
      echo
      echo "ACCUMULATE AND RESPECT ALL GUIDANCE AND INTENT PER YOUR ROLE (STAY IN YOUR LANE!)\n"
    ) \
    | ai:cat "$@" \
    | bat \
        --paging=never --style=plain --language=markdown --italic-text=always \
        --theme-dark='Solarized (dark)' --theme-light='Solarized (light)'
  )
)

# Wrapper to set strict mode and current session ID.
ai:run () (
  set -${AIWTF:+x}euo pipefail
  if test -n "$AITAG"; then
    if test "$AITAG" = "$AITOP"; then
      ai:sys:stdio >&2
      return 1
    elif test "$AITAG" = "$(ai:tag:3)"; then
      ai:sys:rules >&2
      return 2
    fi
  fi
  AISID=$(ai:sid)
  "$1" "${@:2}"
)

# Direct alias to underlying AI model command.
# Workaround to case-insensitive file/command/function name lookup.
claude () { command claude "$@"; }

# Automatically re-link to current session.
Claude () { AIGEN=claude ai:run ai:gen --dangerously-skip-permissions "$@"; }

# Debugging alias.
alias "WTF= AIWTF=x "

# Dynamic modifiers for roles.
alias "Customer= AIMOD=customer "
alias "Engineer= AIMOD=engineer "
alias "Architect= AIMOD=architect "
alias "Haiku= AIMOD=haiku "
alias "Sonnet= AIMOD=sonnet "
alias "Opus= AIMOD=opus "

# Heredoc aliases for interactive use.
alias "Claude,= AIGEN=claude ai:run ai:ask --dangerously-skip-permissions << '${AITID-}'"
alias "Assistant,= ai:run ai:ask << '${AITID-}'"
alias "Agent,= ai:run ai:ask << '${AITID-}'"
alias "AI,= ai:run ai:ask << '${AITID-}'"

# MUST be first! Differentiates first call (empty) from all nested calls.
export AITOP="${AITAG:-}"
export AITAG="$(ai:tag:3)"

# Unique per conversation thread; persists across calls.
export AITID="${AITID:-"$(uuidgen | tr -u ABCDEF abcdef)"}"
export AISID="${AISID:-"$AITID"}"

# AI model to use; default is 'claude'.
export AIGEN="${AIGEN:-"claude"}"
export AIMOD="${AIMOD:-}"

# If set, enables debugging output.
export AIWTF="${AIWTF:-}"

if test -z "$AIMOD" -a "$VSCODE_INJECTION" = "1"; then
  # Undifferentiated role claimed by Copilot in VSCode.
  AIMOD="architect"
fi
