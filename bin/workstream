#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  workstream [--repo PATH] [--dir PATH] [--scope GLOB] [--mission TEXT] \
                [MODEL_A] [MODEL_B]

Defaults:
  repo     = git rev-parse --show-toplevel from current directory
  dir      = new /tmp/<repo>-workstream.XXXXXX directory
  scope    = omitted
  mission  = omitted
  MODEL_A  = claude-opus-4.6
  MODEL_B  = gpt-5.3-codex

Behavior:
  - creates or re-enters a workstream operating directory
  - seeds TODO.md / WORKSTREAM.md / WORKLOG.md / GOAL.md /
    peer-a.sh / peer-b.sh
  - persists peer UUIDs and metadata in state.env
  - prints a paste-ready takeover block for a primary agent
EOF
}

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

find_upward_file() {
  local start="$1"
  local name="$2"
  local dir

  dir="$(cd "$start" && pwd)"
  while :; do
    if [[ -f "$dir/$name" ]]; then
      printf '%s\n' "$dir/$name"
      return 0
    fi
    if [[ "$dir" == "/" ]]; then
      break
    fi
    dir="$(dirname "$dir")"
  done

  return 1
}

quote_sh() {
  printf "%q" "$1"
}

model_a="${WORKSTREAM_MODEL_A:-claude-opus-4.6}"
model_b="${WORKSTREAM_MODEL_B:-gpt-5.3-codex}"
scope=""
repo=""
work_dir=""
mission=""
repo_arg_set=0
scope_arg_set=0
mission_arg_set=0

positionals=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --repo)
      [[ $# -ge 2 ]] || die "--repo requires a path"
      repo="$2"
      repo_arg_set=1
      shift 2
      ;;
    --dir)
      [[ $# -ge 2 ]] || die "--dir requires a path"
      work_dir="$2"
      shift 2
      ;;
    --scope)
      [[ $# -ge 2 ]] || die "--scope requires a glob"
      scope="$2"
      scope_arg_set=1
      shift 2
      ;;
    --mission)
      [[ $# -ge 2 ]] || die "--mission requires text"
      mission="$2"
      mission_arg_set=1
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      while [[ $# -gt 0 ]]; do
        positionals+=("$1")
        shift
      done
      ;;
    -*)
      die "unknown flag: $1"
      ;;
    *)
      positionals+=("$1")
      shift
      ;;
  esac
done

if [[ ${#positionals[@]} -ge 1 ]]; then
  model_a="${positionals[0]}"
fi
if [[ ${#positionals[@]} -ge 2 ]]; then
  model_b="${positionals[1]}"
fi
if [[ ${#positionals[@]} -gt 2 ]]; then
  die "too many positional arguments"
fi

if [[ -n "$work_dir" ]]; then
  mkdir -p "$work_dir"
else
  repo_seed="$repo"
  if [[ -z "$repo_seed" ]]; then
    repo_seed="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  fi
  [[ -n "$repo_seed" ]] || die "could not determine repo; use --repo"
  repo_seed="$(cd "$repo_seed" && pwd)"
  repo_name="$(basename "$repo_seed")"
  work_dir="$(mktemp -d "${TMPDIR:-/tmp}/${repo_name}-workstream.XXXXXX")"
fi
work_dir="$(cd "$work_dir" && pwd)"

state_file="$work_dir/state.env"
todo_file="$work_dir/TODO.md"
workstream_file="$work_dir/WORKSTREAM.md"
worklog_file="$work_dir/WORKLOG.md"
goal_file="$work_dir/GOAL.md"
peer_a_file="$work_dir/peer-a.sh"
peer_b_file="$work_dir/peer-b.sh"
agents_copy_file="$work_dir/AGENTS.md"
voice_copy_file="$work_dir/VOICE.md"
peer_root_dir="$work_dir/peers"
peer_a_dir="$peer_root_dir/peer-a"
peer_b_dir="$peer_root_dir/peer-b"
peer_a_readme_file="$peer_a_dir/README.md"
peer_b_readme_file="$peer_b_dir/README.md"
peer_a_report_file="$peer_a_dir/REPORT.md"
peer_b_report_file="$peer_b_dir/REPORT.md"
peer_a_notes_file="$peer_a_dir/NOTES.md"
peer_b_notes_file="$peer_b_dir/NOTES.md"

mkdir -p "$peer_a_dir/artifacts" "$peer_b_dir/artifacts"

if [[ -f "$state_file" ]]; then
  # shellcheck disable=SC1090
  source "$state_file"
fi

if [[ $repo_arg_set -eq 0 && -n "${WORKSTREAM_REPO:-}" ]]; then
  repo="$WORKSTREAM_REPO"
fi
if [[ $scope_arg_set -eq 0 && -n "${WORKSTREAM_SCOPE:-}" ]]; then
  scope="$WORKSTREAM_SCOPE"
fi
if [[ $mission_arg_set -eq 0 && -n "${WORKSTREAM_MISSION:-}" ]]; then
  mission="$WORKSTREAM_MISSION"
fi

if [[ -z "$repo" ]]; then
  repo="$(git rev-parse --show-toplevel 2>/dev/null || true)"
fi
[[ -n "$repo" ]] || die "could not determine repo; use --repo"
[[ -d "$repo" ]] || die "repo path does not exist: $repo"
git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "not a git repository: $repo"

repo="$(cd "$repo" && pwd)"
repo_name="$(basename "$repo")"

agents_src="$(find_upward_file "$repo" "AGENTS.md" || true)"
voice_src="$(find_upward_file "$repo" "VOICE.md" || true)"
if [[ -z "$agents_src" && -f ~/AGENTS.md ]]; then
  agents_src=~/AGENTS.md
fi
if [[ -z "$voice_src" && -f ~/VOICE.md ]]; then
  voice_src=~/VOICE.md
fi
if [[ -n "$agents_src" ]]; then
  cp "$agents_src" "$agents_copy_file"
fi
if [[ -n "$voice_src" ]]; then
  cp "$voice_src" "$voice_copy_file"
fi

uuid_a="${WORKSTREAM_UUID_A:-$(uuidgen | tr '[:upper:]' '[:lower:]')}"
uuid_b="${WORKSTREAM_UUID_B:-$(uuidgen | tr '[:upper:]' '[:lower:]')}"
created_at="${WORKSTREAM_CREATED:-$(date -u +"%Y-%m-%dT%H:%M:%SZ")}"

mapfile -t scope_files < <(
  if [[ -n "$scope" ]]; then
    cd "$repo"
    shopt -s nullglob
    files=( $scope )
    printf '%s\n' "${files[@]}"
  fi
)
if [[ -n "$scope" && ${#scope_files[@]} -eq 0 ]]; then
  die "scope resolved to zero files: $scope"
fi

{
  printf 'WORKSTREAM_REPO=%q\n' "$repo"
  printf 'WORKSTREAM_DIR=%q\n' "$work_dir"
  printf 'WORKSTREAM_SCOPE=%q\n' "$scope"
  printf 'WORKSTREAM_CREATED=%q\n' "$created_at"
  printf 'WORKSTREAM_MODEL_A=%q\n' "$model_a"
  printf 'WORKSTREAM_MODEL_B=%q\n' "$model_b"
  printf 'WORKSTREAM_UUID_A=%q\n' "$uuid_a"
  printf 'WORKSTREAM_UUID_B=%q\n' "$uuid_b"
  printf 'WORKSTREAM_MISSION=%q\n' "$mission"
  printf 'WORKSTREAM_AGENTS_SOURCE=%q\n' "$agents_src"
  printf 'WORKSTREAM_VOICE_SOURCE=%q\n' "$voice_src"
  printf 'WORKSTREAM_PEER_ROOT=%q\n' "$peer_root_dir"
  printf 'WORKSTREAM_PEER_A_DIR=%q\n' "$peer_a_dir"
  printf 'WORKSTREAM_PEER_B_DIR=%q\n' "$peer_b_dir"
} >"$state_file"

if [[ ! -f "$peer_a_readme_file" ]]; then
  cat >"$peer_a_readme_file" <<EOF
# Peer A Workspace

This directory is the isolated write surface for peer A.

Expected outputs:

- \`REPORT.md\`: main peer report and sign-off
- \`NOTES.md\`: running notes and proposed shared-file updates
- \`artifacts/\`: peer-local captures, snapshots, and scratch outputs

Guardrail:

- Avoid editing shared top-level workstream files unless the primary agent
  explicitly asks after review.
EOF
fi

if [[ ! -f "$peer_a_report_file" ]]; then
  cat >"$peer_a_report_file" <<'EOF'
# Peer A Report

Write the main peer report and sign-off here.
EOF
fi

if [[ ! -f "$peer_a_notes_file" ]]; then
  cat >"$peer_a_notes_file" <<'EOF'
# Peer A Notes

Use this file for running notes and proposed shared-file updates.
EOF
fi

if [[ ! -f "$peer_b_readme_file" ]]; then
  cat >"$peer_b_readme_file" <<EOF
# Peer B Workspace

This directory is the isolated write surface for peer B.

Expected outputs:

- \`REPORT.md\`: main peer report and sign-off
- \`NOTES.md\`: running notes and proposed shared-file updates
- \`artifacts/\`: peer-local captures, snapshots, and scratch outputs

Guardrail:

- Avoid editing shared top-level workstream files unless the primary agent
  explicitly asks after review.
EOF
fi

if [[ ! -f "$peer_b_report_file" ]]; then
  cat >"$peer_b_report_file" <<'EOF'
# Peer B Report

Write the main peer report and sign-off here.
EOF
fi

if [[ ! -f "$peer_b_notes_file" ]]; then
  cat >"$peer_b_notes_file" <<'EOF'
# Peer B Notes

Use this file for running notes and proposed shared-file updates.
EOF
fi

if [[ ! -f "$todo_file" ]]; then
  {
    cat <<EOF
# ${repo_name^} Workstream TODO

This file is the coordination point and the definition of done for this
workstream.

It is a bootstrap scaffold, not a finished plan. Expand it aggressively as the
real work reveals itself. Add missing batteries, checkpoints, peer
artifacts, and any other concrete work needed to make the definition of done
true in reality rather than only on paper.

## Definition Of Done

This workstream is done only when all of the following are true:

- The active target set has been examined against current local truth.
- Conflicting claims have been corrected, removed, or explicitly parked with rationale.
- Peer findings have been incorporated or explicitly dispositioned.
- Links, anchors, and internal references are coherent where they matter.
- Dangerous guidance has been reduced to the narrowest safe form.
- Final peer sign-off has been collected after edits and verification.
- Final verification has been run against the active target set.

## Status

- This block is only the bootstrap floor. It should grow.
- If important work is missing, add it explicitly rather than treating it as
  implied.
- [x] Operating directory established at \`$work_dir\`
- [ ] GOAL.md rewritten by the active agent from live context
- [ ] TODO.md expanded by the active agent into a real working checklist
- [ ] Initial peer pass collected from peer A
- [ ] Initial peer pass collected from peer B
- [ ] Final peer sign-off collected after edits
EOF
    if [[ -n "$scope" ]]; then
      cat <<EOF
- [x] Scope locked to \`$scope\`
EOF
    fi
    printf '\n'
    if [[ -n "$scope" ]]; then
      cat <<'EOF'
## File Battery

EOF
      for path in "${scope_files[@]}"; do
        printf -- '- [ ] `%s`\n' "$path"
      done
      printf '\n'
    fi
    cat <<'EOF'
## Drift / Truth Battery

- Seed placeholder. Replace with concrete truth-mismatch work as soon as it is
  discovered.

## Mechanical / Safety Battery

- Seed placeholder. Replace with concrete mechanical, anchor, link, and
  dangerous-guidance work as soon as it is discovered.

## Peer Notes

- Seed placeholder. Add peer artifacts, findings, and dispositions as they
  actually happen.
- Peer A:
  - [ ] Report collected
  - [ ] Findings dispositioned
- Peer B:
  - [ ] Report collected
  - [ ] Findings dispositioned

## Final Sign-off Notes

- Seed placeholder. Replace with final sign-off artifacts and any remaining
  closing checks.
EOF
  } >"$todo_file"
fi

if [[ ! -f "$workstream_file" ]]; then
  {
    cat <<EOF
# ${repo_name^} Workstream

## Scope

- Repository: \`$repo\`
- Operating directory: \`$work_dir\`
EOF
    if [[ -n "$scope" ]]; then
      printf -- '- Target glob: `%s`\n' "$scope"
      printf -- '- Frozen target set:\n'
      for path in "${scope_files[@]}"; do
        printf '  - `%s`\n' "$path"
      done
    fi
    cat <<'EOF'

## Operating Files

- `TODO.md`: canonical definition of done and execution checklist
- `WORKSTREAM.md`: standing frame for scope, constraints, findings, and edit
  shape
- `WORKLOG.md`: running log of bootstrap facts, peer artifacts, findings,
  dispositions, and sign-off trail
- `GOAL.md`: current live briefing to rewrite from the present moment and use
  for peer launches

## Hard Constraints

- Treat `TODO.md` as the canonical definition of done.
- User interjections are additive steering: add them to the stack or the
  workstream, do not treat them as stopping signals, and do not silently
  rewrite the definition of done because of them.
- Do not interrupt peers once they are running; let them finish or fail.
- Secure peer sign-off before edits and again before declaring completion.
- Inspect closely, down to small line-level defects.
- Prefer timeless, intentional, idiomatic, prototypical outcomes.
- Use durable files in this operating directory instead of transcript memory.

## Peer Status

- Peer A: pending
- Peer B: pending

## Current Findings

### Mechanical

- Populate during survey.

### Navigation / Information Architecture

- Populate during survey.

### Deployment Truth

- Populate from live code / config / infra reads.

## Candidate Edit Set

- Populate after the initial survey.
EOF
  } >"$workstream_file"
fi

if [[ ! -f "$worklog_file" ]]; then
  {
    cat <<EOF
# Worklog

## $(date +"%Y-%m-%d") / Bootstrap

- Bootstrapped by \`$(basename "$0")\`
- Repository: \`$repo\`
- Operating directory: \`$work_dir\`
- Models: peer A = \`$model_a\`, peer B = \`$model_b\`
- Resume UUIDs:
  - peer A: \`$uuid_a\`
  - peer B: \`$uuid_b\`
EOF
    if [[ -n "$scope" ]]; then
      printf -- '- Scope: `%s`\n' "$scope"
    fi
    if [[ -n "$agents_src" ]]; then
      printf -- '- Imported `AGENTS.md`\n'
    fi
    if [[ -n "$voice_src" ]]; then
      printf -- '- Imported `VOICE.md`\n'
    fi
    printf -- '- Seeded as the durable operating log for this workstream\n'
  } >"$worklog_file"
fi

if [[ ! -f "$goal_file" ]]; then
  {
    cat <<EOF
# Seed Goal Placeholder

This file was bootstrapped by \`$(basename "$0")\`.

It is intentionally **not** the final goal briefing. The receiving agent
should rewrite GOAL.md from its own live understanding of the repo, the
current user intent, the active target set, the peer state, and whatever
changed since bootstrap.

Bootstrap facts:

- Repository: \`$repo\`
- Operating directory: \`$work_dir\`
- Canonical coordination file: \`TODO.md\`
- Supporting artifacts: \`WORKSTREAM.md\`, \`WORKLOG.md\`, \`state.env\`
EOF
    if [[ -n "$scope" ]]; then
      printf -- '- Scope seed: `%s`\n' "$scope"
    fi
    if [[ -n "$mission" ]]; then
      printf -- '- Mission seed: %s\n' "$mission"
    fi
    if [[ -n "$agents_src" ]]; then
      printf -- '- AGENTS.md present in this directory\n'
    fi
    if [[ -n "$voice_src" ]]; then
      printf -- '- VOICE.md present in this directory\n'
    fi
    cat <<'EOF'

GOAL.md rule:

- Read `TODO.md`, `WORKSTREAM.md`, and `WORKLOG.md`.
- Rewrite `GOAL.md` in place so it reflects the current moment.
- Keep `GOAL.md` durable for peer launches and reruns.
EOF
  } >"$goal_file"
fi

cat >"$peer_a_file" <<EOF
#!/usr/bin/env bash
set -euo pipefail

ws=$(quote_sh "$work_dir")
repo=$(quote_sh "$repo")
peer_dir=$(quote_sh "$peer_a_dir")
goal_file="\$ws/GOAL.md"

if [[ \$# -gt 1 ]]; then
  printf 'usage: %s [goal-file]\n' "\$(basename "\$0")" >&2
  exit 1
fi

goal_input_file="\${1:-\$goal_file}"
[[ -f "\$goal_input_file" ]] || {
  printf 'error: goal file does not exist: %s\n' "\$goal_input_file" >&2
  exit 1
}

tmp_prompt="\$(mktemp)"
cleanup() {
  rm -f "\$tmp_prompt"
}
trap cleanup EXIT

cat >"\$tmp_prompt" <<'PROMPT'
You are peer A inside a shared workstream.

Read shared files freely, but treat the shared top-level workstream files as
read-only by default:

- TODO.md
- WORKSTREAM.md
- WORKLOG.md
- GOAL.md
- top-level graph or summary artifacts

Your write surface is confined to the peer directory named below.

If you want the primary agent to change a shared file, record that under a
"Proposed shared-file updates" section in REPORT.md instead of editing the
shared file directly.

Keep continuous narration. Do not trample sibling peer files.
PROMPT
printf '\nPeer identity:\n- label: peer A\n- write surface: %s\n- report file: %s/REPORT.md\n- notes file: %s/NOTES.md\n- artifact dir: %s/artifacts/\n\nShared goal follows:\n\n' "\$peer_dir" "\$peer_dir" "\$peer_dir" "\$peer_dir" >>"\$tmp_prompt"
cat "\$goal_input_file" >>"\$tmp_prompt"

cd "\$repo"
copilot --yolo --experimental --no-ask-user --no-alt-screen --stream=on --model=$(quote_sh "$model_a") --resume=$(quote_sh "$uuid_a") --prompt="\$(<"\$tmp_prompt")"
EOF
chmod +x "$peer_a_file"

cat >"$peer_b_file" <<EOF
#!/usr/bin/env bash
set -euo pipefail

ws=$(quote_sh "$work_dir")
repo=$(quote_sh "$repo")
peer_dir=$(quote_sh "$peer_b_dir")
goal_file="\$ws/GOAL.md"

if [[ \$# -gt 1 ]]; then
  printf 'usage: %s [goal-file]\n' "\$(basename "\$0")" >&2
  exit 1
fi

goal_input_file="\${1:-\$goal_file}"
[[ -f "\$goal_input_file" ]] || {
  printf 'error: goal file does not exist: %s\n' "\$goal_input_file" >&2
  exit 1
}

tmp_prompt="\$(mktemp)"
cleanup() {
  rm -f "\$tmp_prompt"
}
trap cleanup EXIT

cat >"\$tmp_prompt" <<'PROMPT'
You are peer B inside a shared workstream.

Read shared files freely, but treat the shared top-level workstream files as
read-only by default:

- TODO.md
- WORKSTREAM.md
- WORKLOG.md
- GOAL.md
- top-level graph or summary artifacts

Your write surface is confined to the peer directory named below.

If you want the primary agent to change a shared file, record that under a
"Proposed shared-file updates" section in REPORT.md instead of editing the
shared file directly.

Keep continuous narration. Do not trample sibling peer files.
PROMPT
printf '\nPeer identity:\n- label: peer B\n- write surface: %s\n- report file: %s/REPORT.md\n- notes file: %s/NOTES.md\n- artifact dir: %s/artifacts/\n\nShared goal follows:\n\n' "\$peer_dir" "\$peer_dir" "\$peer_dir" "\$peer_dir" >>"\$tmp_prompt"
cat "\$goal_input_file" >>"\$tmp_prompt"

cd "\$repo"
copilot --yolo --experimental --no-ask-user --no-alt-screen --stream=on --model=$(quote_sh "$model_b") --resume=$(quote_sh "$uuid_b") --prompt="\$(<"\$tmp_prompt")"
EOF
chmod +x "$peer_b_file"

cat <<EOF
Take over this workstream from live context, not from stale assumptions.

Let \`REPO=$repo\`.
Let \`WS=$work_dir\`.

Use \`\$REPO\` as the repo root.
Use \`\$WS\` as the durable coordination surface.

File roles:

- \`\$WS/TODO.md\`: canonical definition of done and checklist
- \`\$WS/WORKSTREAM.md\`: standing frame for scope, constraints, and findings
- \`\$WS/WORKLOG.md\`: running log for bootstrap facts, peer artifacts,
  dispositions, and sign-off
- \`\$WS/GOAL.md\`: live briefing to rewrite from the current moment and use
  for peer launches
- \`\$WS/peers/peer-a/\`: isolated peer A write surface
- \`\$WS/peers/peer-b/\`: isolated peer B write surface

Ownership rule:

- The primary agent owns shared top-level files under \`\$WS/\`.
- Peers should write under their own isolated peer directories first.
- Integrate peer findings back into shared files one at a time after review.

Start by reading:

- \`\$WS/state.env\`
- \`\$WS/TODO.md\`
- \`\$WS/WORKSTREAM.md\`
- \`\$WS/WORKLOG.md\`
- \`\$WS/GOAL.md\`
EOF
if [[ -n "$agents_src" ]]; then
  cat <<EOF
- \`\$WS/AGENTS.md\`
EOF
fi
if [[ -n "$voice_src" ]]; then
  cat <<EOF
- \`\$WS/VOICE.md\`
EOF
fi
cat <<EOF

Then rewrite \`\$WS/GOAL.md\` from your own current understanding and this
exact moment. Do not trust the seeded placeholder as final truth.

Treat \`\$WS/TODO.md\` as the canonical definition of done.
If the user interjects, add what they said to the stack or the workstream.
Do not treat interjections as stopping signals, and do not silently mutate the
definition of done because the user injected more steering.
Work with your peers using the persisted UUIDs below. Ask for
continuous narration, do not interrupt running peers, and secure sign-off
before edits and before declaring completion.

EOF
if [[ -n "$scope" ]]; then
  cat <<EOF
Scope seed:

- \`$scope\`

EOF
fi
if [[ -n "$mission" ]]; then
  cat <<EOF
Mission seed:

$mission

EOF
fi
cat <<EOF
Peer continuity:

- Peer A model: \`$model_a\`
- Peer A UUID: \`$uuid_a\`
- Peer B model: \`$model_b\`
- Peer B UUID: \`$uuid_b\`

Useful artifacts already present in \`\$WS\`:

- \`\$WS/GOAL.md\`
- \`\$WS/TODO.md\`
- \`\$WS/WORKSTREAM.md\`
- \`\$WS/WORKLOG.md\`
- \`\$WS/peer-a.sh\`
- \`\$WS/peer-b.sh\`
EOF
if [[ -n "$agents_src" ]]; then
  cat <<EOF
- \`\$WS/AGENTS.md\`
EOF
fi
if [[ -n "$voice_src" ]]; then
  cat <<EOF
- \`\$WS/VOICE.md\`
EOF
fi
cat <<EOF

Peer launch scripts are \`\$WS/peer-a.sh\` and
\`\$WS/peer-b.sh\`.

Go ahead and start implementing with your peers; ask for their continuous
narration, and secure full peer sign-off before starting and prior
to declaring completion. Never interrupt a running peer for any reason
whatsoever once started; allow them to finish or fail on their own. Voraciously
devour the available guidance until you're confident you've internalized its
axioms and are committed to exhausting all edge cases from its perspective.
Seek timeless, intentional, idiomatic, prototypical outcomes.
This message is not a stopping signal; continue until there is nothing left to
run inside the workstream.
EOF
